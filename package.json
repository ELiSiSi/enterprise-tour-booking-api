{
  "name": "enterprise-tour-booking-api",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/app.ts",
    "dev:worker": "cross-env NODE_ENV=development tsx watch src/worker.ts",
    "start": "cross-env NODE_ENV=production node dist/app.js",
    "worker": "cross-env NODE_ENV=production node dist/worker.js",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run type-check && npm test && npm run build",
    "test:watch": "vitest watch",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "TypeScript REST API for tour management and Stripe-backed bookings",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.2",
    "bullmq": "^6.3.12",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-async-handler": "^1.2.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "html-to-text": "^9.0.5",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "mongoose": "^8.18.3",
    "morgan": "^1.10.1",
    "ms": "^2.1.3",
    "multer": "^2.0.2",
    "nodemailer": "^10.1.0",
    "pug": "^3.0.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "slugify": "^1.6.6",
    "speakeasy": "^2.0.0",
    "stripe": "^20.2.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.15.15",
    "winston": "^3.19.0",
    "xss-clean": "^0.1.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pug": "^2.0.10",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/validator": "^13.15.10",
    "cross-env": "^10.1.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
